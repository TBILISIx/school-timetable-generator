<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.solvd.schooltimetablegenerator.dao.TimeSlotDao">

    <!-- ResultMap -->
    <resultMap id="TimeSlotResultMap" type="TimeSlot">
        <id property="id" column="id"/>
        <result property="dayOfWeek" column="day_of_week"/>
        <result property="periodNumber" column="period_number"/>
    </resultMap>

    <!-- findAll -->
    <select id="findAll" resultMap="TimeSlotResultMap">
        SELECT id, day_of_week, period_number FROM time_slots
    </select>

    <!-- findById -->
    <select id="findById" parameterType="java.lang.Long" resultMap="TimeSlotResultMap">
        SELECT id, day_of_week, period_number FROM time_slots
        WHERE id = #{id}
    </select>

    <!-- insert -->
    <insert id="insert" parameterType="TimeSlot" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO time_slots (day_of_week, period_number)
        VALUES (#{dayOfWeek}, #{periodNumber})
    </insert>

    <!-- deleteAll -->
    <delete id="deleteAll">
        DELETE FROM time_slots
    </delete>

</mapper>
